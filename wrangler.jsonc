{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "client-dashboard-personal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DASHBOARD_USERNAME": "owner"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-dashboard-db",
      "database_id": "75944dc9-89e8-43ed-95dd-653995d47a0d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "client-dashboard-files"
    }
  ]
}
