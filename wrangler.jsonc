{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "client-dashboard-personal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DASHBOARD_USERNAME": "owner"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-dashboard-db",
      "database_id": "780a9d4f-d953-4f64-b14d-32cede62048e",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "client-dashboard-files"
    }
  ]
}
